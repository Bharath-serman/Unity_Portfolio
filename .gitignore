# ===================================================
# Unity 3D URP Project .gitignore
# ===================================================

# OS / Editor specific
.DS_Store
Thumbs.db
Library/
Temp/
Obj/
Build/
Builds/
Logs/
MemoryCaptures/
UserSettings/

# Unity specific
*.unitypackage
*.pidb
*.suo
*.user
*.userprefs
*.csproj
*.unityproj
*.tmp
*.booproj
*.svd
*.pdb
*.mdb

# Rider / VS / VSCode
.idea/
.vscode/
*.csproj
*.sln
*.DotSettings.user

# Cache and Autogenerated
sysinfo.txt
/.vs/
ExportedObj/
Assets/AssetStoreTools*
/ProjectSettings/EditorBuildSettings.asset
/ProjectSettings/EditorSettings.asset

# Build Artifacts
*.apk
*.aab
*.app
*.exe
*.dll
*.mp4
*.zip

# Generated Lighting / GI / Shader Cache
LightingData.asset
Lightmap-*
GICache/
ShaderCache/

# Package Manager cache
node_modules/
obj/
Temp/

# Logs
*.log

# Crash Reports
*.stackdump

# ===================================================
# Keep essential project folders
# ===================================================
!Assets/
!Packages/
!ProjectSettings/
!README.md
